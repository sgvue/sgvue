# https://editorconfig.org — what the code already does: UTF-8, LF, a final newline, no
# trailing white space, two-space indents (four in the Python generators).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
